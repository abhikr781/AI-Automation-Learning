    {
      "parameters": {
        "promptType": "define",
        "text": "=You are a Sales Follow-up Specialist.\n\nAnalyze the lead details and decide whether a follow-up email should be sent.\n\nLead Details:\n- Name: {{ $json[\"Name\"] }}\n- Company: {{ $json[\"Company\"] }}\n- Lead Quality: {{ $json[\"Lead Quality\"] }}\n- Last Contact: {{ $json[\"Last Contact\"] }}\n- Status: {{ $json[\"Status\"] }}\n- Requirement: {{ $json[\"Requirement\"] }}\n\nRules:\n1. Send follow-up if Lead Quality is \"Hot\" and no response for 3+ days, or if they requested a demo/proposal.\n2. Do NOT send follow-up if Status is \"Not Interested\" or \"Follow-up Sent\".\n3. Do NOT send follow-up if Last Contact was \"Yesterday\" or \"Today\" unless urgent action was explicitly requested.\n4. Keep email short, warm, and highly relevant to their requirement.",
        "hasOutputParser": true,
        "options": {}
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        416,
        0
      ],
      "id": "0b814750-32b0-4aae-a2ab-81b675e077bd",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"send_followup\": {\n      \"type\": \"boolean\",\n      \"description\": \"True if email should be sent, false otherwise.\"\n    },\n    \"reason\": {\n      \"type\": \"string\",\n      \"description\": \"Brief explanation of why follow-up is needed or skipped.\"\n    },\n    \"email_subject\": {\n      \"type\": \"string\",\n      \"description\": \"Short professional subject line if send_followup is true.\"\n    },\n    \"email_body\": {\n      \"type\": \"string\",\n      \"description\": \"Personalized email body if send_followup is true.\"\n    }\n  },\n  \"required\": [\"send_followup\", \"reason\", \"email_subject\", \"email_body\"]\n}"
      },
