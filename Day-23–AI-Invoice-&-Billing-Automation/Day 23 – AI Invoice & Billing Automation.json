    {
      "parameters": {
        "jsCode": "let inputData = $input.first().json;\nlet rawData = inputData.output || inputData;\nlet safeOutput = {};\n\n// Static Company Info\nsafeOutput.company_name = \"AI Automation Solutions\";\nsafeOutput.company_email = \"billing@aiautomation.io\";\nsafeOutput.company_phone = \"+91 98765 43210\";\nsafeOutput.company_gstin = \"07AAAAA0000A1Z5\";\nsafeOutput.company_website = \"www.aiautomation.io\";\n\n// Format Line Items Array into text table\nlet items = rawData.items || [];\nlet tableRows = [];\ntableRows.push(\"Description\".padEnd(35) + \"Qty\".padEnd(8) + \"Price\".padEnd(15) + \"Total\");\ntableRows.push(\"-\".repeat(70));\n\nif (Array.isArray(items) && items.length > 0) {\n  items.forEach(item => {\n    let desc = String(item.description || \"Service\").padEnd(35);\n    let qty = String(item.quantity || 1).padEnd(8);\n    let price = String(item.unit_price || \"₹0.00\").padEnd(15);\n    let total = String(item.total || \"₹0.00\");\n    tableRows.push(`${desc}${qty}${price}${total}`);\n  });\n}\nsafeOutput.line_items_table = tableRows.join(\"\\n\");\n\n// Enforce string conversion for all other parameters\nfor (let key in rawData) {\n  if (key !== 'items') {\n    safeOutput[key] = (rawData[key] === null || rawData[key] === undefined || rawData[key] === \"\") \n      ? \"N/A\" \n      : String(rawData[key]);\n  }\n}\n\nreturn { safeOutput };"
      },
