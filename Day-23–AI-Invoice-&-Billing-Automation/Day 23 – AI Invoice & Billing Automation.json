    {
      "parameters": {
        "jsCode": "// Get n8n workflow static data storage\nconst staticData = $getWorkflowStaticData('global');\n\n// Get current date string (YYYYMMDD)\nconst now = new Date();\nconst year = now.getFullYear();\nconst month = String(now.getMonth() + 1).padStart(2, '0');\nconst day = String(now.getDate()).padStart(2, '0');\nconst dateStr = `${year}${month}${day}`;\n\n// 1. Check if date changed -> Reset counter to 1 for a new day\nif (staticData.lastDate !== dateStr) {\n  staticData.lastDate = dateStr;\n  staticData.invoiceCounter = 1;\n}\n\n// 2. Fetch current counter value\nlet currentCounter = staticData.invoiceCounter || 1;\n\n// 3. Format counter to 3 digits (e.g., 001, 002)\nconst formattedCounter = String(currentCounter).padStart(3, '0');\nconst invoiceNumber = `INV-${dateStr}-${formattedCounter}`;\n\n// 4. Increment counter for the NEXT execution\nstaticData.invoiceCounter = currentCounter + 1;\n\n// Return both invoice number and user chat input\nreturn {\n  invoice_number: invoiceNumber,\n  chatInput: $('When chat message received').item.json.chatInput\n};"
      },
