      "parameters": {
        "schemaType": "manual",
        "inputSchema": "={\n  \"type\": \"object\",\n  \"properties\": {\n    \"invoice_number\": { \"type\": \"string\" },\n    \"invoice_date\": { \"type\": \"string\" },\n    \"due_date\": { \"type\": \"string\" },\n    \"invoice_status\": { \"type\": \"string\" },\n    \"payment_status\": { \"type\": \"string\" },\n    \"payment_methods\": { \"type\": \"string\" },\n    \"client_name\": { \"type\": \"string\" },\n    \"client_email\": { \"type\": \"string\" },\n    \"items\": {\n      \"type\": \"array\",\n      \"items\": {\n        \"type\": \"object\",\n        \"properties\": {\n          \"description\": { \"type\": \"string\" },\n          \"quantity\": { \"type\": \"number\" },\n          \"unit_price\": { \"type\": \"string\" },\n          \"total\": { \"type\": \"string\" }\n        },\n        \"required\": [\"description\", \"quantity\", \"unit_price\", \"total\"]\n      }\n    },\n    \"subtotal\": { \"type\": \"string\" },\n    \"gst_percentage\": { \"type\": \"string\" },\n    \"gst_amount\": { \"type\": \"string\" },\n    \"grand_total\": { \"type\": \"string\" },\n    \"payment_terms\": { \"type\": \"string\" },\n    \"notes\": { \"type\": \"string\" },\n    \"thank_you_message\": { \"type\": \"string\" },\n    \"is_valid\": { \"type\": \"boolean\" },\n    \"error_flag\": { \"type\": \"string\" }\n  },\n  \"required\": [\n    \"invoice_number\", \"invoice_date\", \"due_date\", \"client_name\", \n    \"items\", \"subtotal\", \"grand_total\", \"is_valid\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
