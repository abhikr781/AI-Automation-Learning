    {
      "parameters": {
        "jsCode": "let rawText = $input.first().json.output || $input.first().json.text || \"\";\n\n// Today's Date\nconst todayDate = new Date().toISOString().split('T')[0];\n\n// Extract JSON part between JSON_START and JSON_END\nlet jsonString = rawText;\nif (rawText.includes(\"JSON_START\")) {\n  jsonString = rawText.split(\"JSON_START\")[1].split(\"JSON_END\")[0].trim();\n}\n\n// Clean any leftover markdown blocks\njsonString = jsonString.replace(/```json/g, '').replace(/```/g, '').trim();\n\ntry {\n  const parsedData = JSON.parse(jsonString);\n  parsedData.date = todayDate;\n  return [{ json: parsedData }];\n} catch (e) {\n  const extractField = (key) => {\n    const match = rawText.match(new RegExp(`\"${key}\"\\\\s*:\\\\s*\"([^\"]*)\"`));\n    return match ? match[1] : \"Not Provided\";\n  };\n\n  return [{\n    json: {\n      name: extractField(\"name\"),\n      email: extractField(\"email\"),\n      phone: extractField(\"phone\"),\n      company: extractField(\"company\"),\n      requirement: extractField(\"requirement\"),\n      budget: extractField(\"budget\"),\n      priority: extractField(\"priority\"),\n      status: \"New Lead\",\n      date: todayDate\n    }\n  }];\n}"
      },
